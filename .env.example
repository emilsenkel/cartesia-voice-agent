# Required: platform API that resolves the dialed number and hosts tool endpoints.
PLATFORM_BASE_URL=https://api.example.com

# API stem for resolve + tool calls (default /api/voice).
# Resolve: {BASE}{PREFIX}/resolve
# Tools:   {BASE}{PREFIX}/{business_id}/tools/{slug}
PLATFORM_TOOL_PATH_PREFIX=/api/voice

# Shared webhook secret; must match the platform. Leave blank in this file.
PLATFORM_WEBHOOK_SECRET=

# Cartesia / LLM provider keys as required by the Line SDK (never commit real values).
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=
